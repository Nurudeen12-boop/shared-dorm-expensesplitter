rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function isMember(gid) { return signedIn() && request.auth.uid in get(groupPath(gid)).data.memberUids; }
    // getAfter() lets a batch that adds the user to memberUids also create their member document.
    function isMemberAfter(gid) { return signedIn() && request.auth.uid in getAfter(groupPath(gid)).data.memberUids; }

    // A user can only read and write their own profile.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow read: if isMember(gid);

      // Creator is the administrator and the only initial member.
      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // existing members may edit the group, but not the admin or the member list
        (isMember(gid)
          && request.resource.data.adminUid == resource.data.adminUid
          && request.resource.data.memberUids == resource.data.memberUids)
        ||
        // anyone with the group link may add THEMSELVES (and only themselves)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids)
      );

      match /members/{mid} {
        allow read: if isMember(gid);
        // you can only create your own member record, or a name-only guest
        allow create: if isMemberAfter(gid) && (
          (mid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.isGuest == false)
          || (request.resource.data.uid == null && request.resource.data.isGuest == true));
        allow update, delete: if isMember(gid) && (resource.data.uid == request.auth.uid || resource.data.isGuest == true);
      }

      // Only the person who logged an expense can edit or delete it.
      match /expenses/{eid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isMember(gid) && resource.data.createdBy == request.auth.uid;
      }

      // Payments are records only. Any member can log one; only the person who logged it can undo it.
      match /payments/{pid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.createdBy == request.auth.uid;
        allow delete: if isMember(gid) && resource.data.createdBy == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
